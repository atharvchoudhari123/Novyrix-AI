# Novyrix server
NOVYRIX_HOST=0.0.0.0
NOVYRIX_PORT=3000
NOVYRIX_FAST_MODE=false
NOVYRIX_ADVANCED_BETA=true
NOVYRIX_MAX_FILE_MB=50

# Text checkpoints
NOVYRIX_3_2_CHECKPOINT=./training/output/novyrix-3.2-scratch
NOVYRIX_4_0_CHECKPOINT=./training/output/novyrix-4.0-scratch
NOVYRIX_5_7_CHECKPOINT=./training/output/novyrix-5.7-scratch

# Local developer-mode secret. Set a private value in .env; never commit it.
NOVYRIX_DEV_MODE_PASSWORD=replace-with-a-private-password

# Local image/video generation checkpoints.
# Models are downloaded lazily the first time they are used.
NOVYRIX_IMAGE_MODEL=runwayml/stable-diffusion-v1-5
NOVYRIX_VIDEO_MODEL=THUDM/CogVideoX-2b

# Account/token limits
NOVYRIX_DAILY_TOKENS=100
NOVYRIX_MESSAGE_COST=5

# Memberships
# free -> 3.2
# core -> 3.2 + 4.0
# premium -> 3.2 + 4.0 + 5.7
